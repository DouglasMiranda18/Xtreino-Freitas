rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() { return request.auth != null; }
    function isSelf(userId) { return isSignedIn() && request.auth.uid == userId; }
    function isAdmin() {
      return isSignedIn() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['admin','Admin','ADMIN','Ceo','CEO','ceo'];
    }
    
    function isVendedor() {
      return isSignedIn() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['vendedor','Vendedor','VENDEDOR'];
    }
    
    function isAfiliado() {
      return isSignedIn() && (
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['afiliado','Afiliado','AFILIADO'] ||
        (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.affiliate == true) ||
        (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.affiliateStatus in ['active','pending','inactive'])
      );
    }

    function isStaff() {
      return isSignedIn() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['staff','Staff','STAFF'];
    }
    
    function isGerente() {
      return isSignedIn() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['gerente','Gerente','GERENTE','admin','Admin','ADMIN','Ceo','CEO','ceo'];
    }

    function isAuthorizedAdmin() {
      return isSignedIn() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['admin','Admin','ADMIN','Ceo','CEO','ceo'] &&
        request.auth.token.email in [
          'cleitondouglass@gmail.com',
          'cleitondouglass123@hotmail.com',
          'gilmariofreitas378@gmail.com',
          'gilmariofreitas387@gmail.com',
          'flavetyr@gmail.com',
          'admin@xtreino.dev'
        ];
    }

    function isAuthorizedAdminOrDesign() {
      return isSignedIn() && (
        (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['admin','Admin','ADMIN','Ceo','CEO','ceo'] &&
         request.auth.token.email in [
           'cleitondouglass@gmail.com',
           'cleitondouglass123@hotmail.com',
           'gilmariofreitas378@gmail.com',
           'gilmariofreitas387@gmail.com',
           'flavetyr@gmail.com',
           'admin@xtreino.dev'
         ]) ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['design','Design','DESIGN','Designer','DESIGNER','designer','Desgin','DESGIN','desgin']
      );
    }

    function isDesign() {
      return isSignedIn() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['design','Design','DESIGN','Designer','DESIGNER','designer','Desgin','DESGIN','desgin'];
    }

    function isSocio() {
      return isSignedIn() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['socio','Socio','SOCIO','sócio','Sócio','SÓCIO','ceo','CEO','Ceo'];
    }

    function canReadAll() {
      return isAdmin() || isGerente() || isVendedor() || isDesign() || isSocio() || isStaff();
    }

    // SEGURANÇA: campos protegidos que usuários não podem auto-modificar
    function hasNoProtectedFieldChanges() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny([
        'tokens', 'role', 'affiliate', 'affiliateStatus', 'affiliateBalance',
        'affiliateCode', 'affiliateParent', 'affiliateSales', 'affiliateRef',
        'affiliateCommission', 'affiliatePaidOut'
      ]);
    }

    // users: cada usuário lê/cria o próprio documento; atualização protege campos sensíveis; só admin pode alterar tokens/role
    // Exceção: usuário pode DIMINUIR seus próprios tokens (spendTokens), mas não pode aumentar
    match /users/{userId} {
      allow read: if isSelf(userId) || canReadAll();
      allow create: if isSelf(userId) || isAdmin();
      allow update: if (isSelf(userId) && hasNoProtectedFieldChanges()) ||
                       (isSelf(userId) &&
                        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['tokens']) &&
                        request.resource.data.tokens < resource.data.tokens &&
                        request.resource.data.tokens >= 0) ||
                       isAdmin();
      allow delete: if isAdmin();
    }

    // schedules: leitura pública para contagem; criação para logados; update/delete apenas staff
    match /schedules/{scheduleId} {
      allow read: if true;
      allow create: if isSignedIn();
      allow update: if isAdmin() || isGerente() || isStaff();
      allow delete: if isAdmin() || isGerente();
    }

    // orders: leitura para staff e para o próprio usuário; criação apenas para o próprio userId; update/delete apenas staff
    match /orders/{orderId} {
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || canReadAll());
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if canReadAll();
      allow delete: if isAdmin();
    }

    // registrations: leitura individual restrita ao dono/staff; listagem liberada para logados (contagem de vagas em tempo real)
    match /registrations/{registrationId} {
      allow get: if isSignedIn() && (
        resource.data.userId == request.auth.uid ||
        canReadAll() ||
        (
          isStaff() && (
            ((resource.data.hour is number) && resource.data.hour >= 14 && resource.data.hour <= 18) ||
            ((resource.data.schedule is string) && resource.data.schedule.matches('.*(\\b14\\b|\\b15\\b|\\b16\\b|\\b17\\b|\\b18\\b|14h|15h|16h|17h|18h|14:00|15:00|16:00|17:00|18:00).*'))
          )
        )
      );
      allow list: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if canReadAll();
      allow delete: if isAdmin() || isGerente();
    }

    // digital_deliveries: leitura para o próprio usuário e staff; criação apenas para o próprio email; update apenas staff
    match /digital_deliveries/{deliveryId} {
      allow read: if isSignedIn() && (resource.data.customerEmail == request.auth.token.email || canReadAll());
      allow create: if isSignedIn() && request.resource.data.customerEmail == request.auth.token.email;
      allow update, delete: if canReadAll();
    }

    // highlights: leitura pública; escrita para admins autorizados e design
    match /highlights/{highlightId} {
      allow read: if true;
      allow create, update, delete: if isAuthorizedAdmin() || isDesign();
    }

    // news: leitura pública; escrita para admins autorizados e design
    match /news/{newsId} {
      allow read: if true;
      allow create, update, delete: if isAuthorizedAdmin() || isDesign();
    }

    // config: leitura pública; escrita apenas para admins autorizados
    match /config/{configId} {
      allow read: if true;
      allow create, update, delete: if isAuthorizedAdmin();
    }

    // products: leitura pública; escrita apenas para admins autorizados
    match /products/{productId} {
      allow read: if true;
      allow create, update, delete: if isAuthorizedAdminOrDesign();
    }

    // product_downloads: leitura para o próprio usuário; criação apenas pelo próprio usuário com status delivered
    match /product_downloads/{downloadId} {
      allow read: if isSignedIn() && (resource.data.customerEmail == request.auth.token.email || isAdmin());
      allow create: if isSignedIn() && request.resource.data.customerEmail == request.auth.token.email && request.resource.data.status == 'delivered';
      allow update, delete: if isAdmin();
    }

    // product_categories: leitura pública; escrita apenas para admins autorizados
    match /product_categories/{categoryId} {
      allow read: if true;
      allow create, update, delete: if isAuthorizedAdminOrDesign();
    }

    // product_inventory: leitura para admins; escrita apenas para admins autorizados
    match /product_inventory/{inventoryId} {
      allow read: if isAdmin() || isDesign();
      allow create, update, delete: if isAuthorizedAdminOrDesign();
    }

    // product_reviews: leitura pública; criação validada (CORRIGIDO: usa request.resource.data no create)
    match /product_reviews/{reviewId} {
      allow read: if true;
      allow create: if isSignedIn() &&
        request.resource.data.productId is string &&
        request.resource.data.customerEmail == request.auth.token.email &&
        request.resource.data.rating >= 1 && request.resource.data.rating <= 5 &&
        request.resource.data.comment.size() <= 500;
      allow update, delete: if isAdmin();
    }

    // product_analytics: leitura para admins; escrita apenas para admins autorizados
    match /product_analytics/{analyticsId} {
      allow read: if isAdmin() || isDesign();
      allow create, update, delete: if isAuthorizedAdminOrDesign();
    }

    // product_discounts: leitura pública; escrita apenas para admins autorizados
    match /product_discounts/{discountId} {
      allow read: if true;
      allow create: if isAuthorizedAdminOrDesign() &&
        request.resource.data.code is string &&
        request.resource.data.discountType in ['percentage', 'fixed'] &&
        request.resource.data.value > 0 &&
        request.resource.data.active is bool;
      allow update, delete: if isAuthorizedAdminOrDesign();
    }

    // product_audit_logs: leitura para admins; escrita apenas para admins autorizados
    match /product_audit_logs/{logId} {
      allow read: if isAdmin() || isDesign();
      allow create, update, delete: if isAuthorizedAdminOrDesign();
    }

    // product_usage_stats: leitura para admins; escrita apenas para admins autorizados
    match /product_usage_stats/{statsId} {
      allow read: if isAdmin() || isDesign();
      allow create, update, delete: if isAuthorizedAdminOrDesign();
    }

    // product_backups: leitura para admins; escrita apenas para admins autorizados
    match /product_backups/{backupId} {
      allow read: if isAdmin() || isDesign();
      allow create, update, delete: if isAuthorizedAdminOrDesign();
    }

    // adminHistory: leitura para staff (admin/gerente/sócio); escrita apenas para admins autorizados
    match /adminHistory/{historyId} {
      allow read: if isAdmin() || isGerente() || isSocio();
      allow create, update, delete: if isAuthorizedAdmin();
    }

    // coupons: leitura para usuários logados (protege exposição pública dos códigos); escrita apenas para admins
    match /coupons/{couponId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isAuthorizedAdmin();
    }

    // couponUsage: leitura para staff e afiliados; criação vinculada ao próprio userId
    match /couponUsage/{usageId} {
      allow read: if isAdmin() || isGerente() || isSocio() || isAfiliado();
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAdmin();
    }
    
    // affiliate_sales: leitura para o próprio afiliado e staff; escrita apenas por staff/admin/gerente
    match /affiliate_sales/{saleId} {
      allow read: if isSignedIn() && (
        isAdmin() || isGerente() || isStaff() ||
        (
          isAfiliado() && (
            resource.data.affiliateId == request.auth.uid ||
            resource.data.affiliateUid == request.auth.uid ||
            resource.data.affiliateEmail == request.auth.token.email
          )
        )
      );
      allow create: if isSignedIn() && (isAdmin() || isGerente() || isStaff());
      allow update: if isAdmin() || isGerente() || isStaff();
      allow delete: if isAdmin();
    }
    
    // affiliate_commissions
    match /affiliate_commissions/{commissionId} {
      allow read: if isSignedIn() && (
        isAdmin() || isGerente() || isStaff() ||
        (
          isAfiliado() && (
            resource.data.affiliateId == request.auth.uid ||
            resource.data.affiliateUid == request.auth.uid ||
            resource.data.affiliateEmail == request.auth.token.email
          )
        )
      );
      allow create: if isSignedIn() && (isAdmin() || isGerente() || isStaff());
      allow update: if isAdmin() || isGerente() || isStaff();
      allow delete: if isAdmin();
    }

    match /affiliate_payout_requests/{requestId} {
      allow create: if isAfiliado() && request.auth.uid == request.resource.data.affiliateId
                    && (request.resource.data.amount is number) && request.resource.data.amount >= 25
                    && (request.resource.data.status == 'pending' || request.resource.data.status == 'requested');
      allow read: if isSignedIn() && (resource.data.affiliateId == request.auth.uid || isAdmin() || isGerente());
      allow update, delete: if isAdmin() || isGerente();
    }

    // whatsapp_links: leitura para usuários logados; escrita para admins, design e sócios
    match /whatsapp_links/{linkId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isAuthorizedAdminOrDesign() || isSocio() || isAdmin() || isGerente();
    }

    // schedule_overrides
    match /schedule_overrides/{overrideId} {
      allow read: if true;
      allow create, update, delete: if isAuthorizedAdminOrDesign() || isSocio() || isAdmin() || isGerente();
    }

    // notifications: todos logados podem ler (filtro no cliente); apenas admins autorizados podem criar/editar/deletar
    match /notifications/{notifId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isAuthorizedAdmin();
    }

    // notificationReads: cada usuário lê/cria suas próprias marcações de leitura; admins podem ler tudo
    match /notificationReads/{readId} {
      allow read: if isSignedIn() && (
        resource.data.userId == request.auth.uid || isAdmin()
      );
      allow create, update: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow delete: if isAdmin();
    }

    // slotCounters: contadores atômicos de slots por evento — leitura e escrita para usuários autenticados
    // Usado para alocar números de slot sem precisar ler registrations de outros usuários
    match /slotCounters/{eventId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    // adminEvents: leitura pública (para exibir eventos no site); escrita apenas para admins autorizados
    match /adminEvents/{eventId} {
      allow read: if true;
      allow create, update, delete: if isAuthorizedAdmin();
    }

    // camp_groups: leitura pública (grupos visíveis no site); escrita apenas para admins autorizados
    match /camp_groups/{groupId} {
      allow read: if true;
      allow create, update, delete: if isAuthorizedAdmin();
    }

    // event_hour_locks: travas permanentes por horário individual (sem data)
    match /event_hour_locks/{lockId} {
      allow read: if true;
      allow create, update, delete: if isAuthorizedAdmin() || isAdmin() || isGerente();
    }

    // event_global_locks: trava geral do evento inteiro (todas as datas)
    match /event_global_locks/{lockId} {
      allow read: if true;
      allow create, update, delete: if isAuthorizedAdmin() || isAdmin() || isGerente();
    }
  }
}
